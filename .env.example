# ================================================
# N8N MORFEUS - TEMPLATE DE CONFIGURAÇÃO
# ================================================
# Copie este arquivo para .env e configure suas variáveis
# cp .env.example .env

# ------------------------------------------------
# CONFIGURAÇÕES BÁSICAS DO N8N
# ------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo

# ------------------------------------------------
# AUTENTICAÇÃO BÁSICA
# IMPORTANTE: Altere para credenciais seguras!
# ------------------------------------------------
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=ALTERE_PARA_SENHA_SEGURA

# ------------------------------------------------
# CHAVE DE CRIPTOGRAFIA
# IMPORTANTE: Gere uma chave única para produção!
# Use: openssl rand -hex 32
# ------------------------------------------------
N8N_ENCRYPTION_KEY=GERE_UMA_CHAVE_COM_openssl_rand_hex_32

# ------------------------------------------------
# BANCO DE DADOS
# Padrão: SQLite (mais simples)
# ------------------------------------------------
DB_TYPE=sqlite

# PostgreSQL (descomente e configure se necessário)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=sua_senha_segura_aqui

# ------------------------------------------------
# CONFIGURAÇÕES DE EXECUÇÃO
# ------------------------------------------------
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=true
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# ------------------------------------------------
# LOGS
# ------------------------------------------------
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# ------------------------------------------------
# FUNCIONALIDADES DE CÓDIGO
# ------------------------------------------------
NODE_FUNCTION_ALLOW_BUILTIN=*
NODE_FUNCTION_ALLOW_EXTERNAL=*

# ------------------------------------------------
# CONFIGURAÇÕES DE E-MAIL (SMTP)
# ------------------------------------------------
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.exemplo.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=seu_email@exemplo.com
N8N_SMTP_PASS=sua_senha_smtp
N8N_SMTP_SENDER=n8n@exemplo.com
N8N_SMTP_SSL=false

# ------------------------------------------------
# INTEGRAÇÕES (adicione suas chaves de API aqui)
# ------------------------------------------------
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_API_KEY=xxx
# TELEGRAM_BOT_TOKEN=xxx:xxx
# DISCORD_BOT_TOKEN=xxx
# SLACK_BOT_TOKEN=xoxb-xxx
# GITHUB_TOKEN=ghp_xxx
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
